{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "@vite_api_url",
    "VITE_UPLOADS_URL": "@vite_uploads_url",
    "VITE_APP_NAME": "SWAT Travels",
    "VITE_APP_DESCRIPTION": "Your Ultimate Travel Companion"
  }
}
